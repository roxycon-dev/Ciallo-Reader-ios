{
  "name": "ciallo-reader-ios",
  "version": "0.0.1",
  "private": true,
  "description": "Ciallo阅读 (EASYREADER) iOS port — TypeScript + Vite + React + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "tokens": "node scripts/generate-design-tokens.mjs",
    "cap:sync": "npm run build && cap sync ios",
    "cap:open": "cap open ios",
    "e2e": "npm run build && playwright test",
    "e2e:ci": "playwright test",
    "gates": "npm run typecheck:ci && npm run lint:ci && npm run test:ci",
    "typecheck:ci": "tsc --noEmit",
    "lint:ci": "eslint src tests --max-warnings=0",
    "test:ci": "vitest run",
    "build:web": "vite build",
    "preview:ci": "vite preview --port 4173 --strictPort",
    "ios:sync": "vite build && cap sync ios && cap copy ios",
    "parity:jvm": "cd parity/android-export && gradlew.bat run",
    "parity:fixtures": "node parity/android-export/run-export.mjs",
    "postinstall": "node scripts/check-node.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "linkedom": "0.18.12",
    "psl": "1.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
